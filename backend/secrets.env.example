# Template for backend/secrets.env. COPY this file (don't rename it) to secrets.env in the
# same folder, then put your real values after the = signs. No quotes, no spaces around the =.
#
# secrets.env is gitignored, so your real keys never get committed.
# This .example file has no real values, so it's safe to commit and share.
# Never paste the real values into chat, GitHub, or the frontend.


# --- Supabase (needed for everything) ---
# SUPABASE_URL: https://<project-id>.supabase.co. The project id is the part after
# /project/ in your Supabase dashboard link.
# SUPABASE_SECRET_KEY: dashboard -> Project Settings -> API Keys -> Secret keys
# (starts with sb_secret_). NOT the publishable key. It skips RLS, so it only ever lives here.
SUPABASE_URL=
SUPABASE_SECRET_KEY=


# --- old password login (/auth/signup, /auth/login) ---
# any long random string. make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Goes away in plans.md Task S5.
JWT_KEY=


# --- job importer (plans.md JB2). All optional: a source without its key skips itself ---
# (Greenhouse, Lever, Ashby, SmartRecruiters, Workable, NSF ETAP, precollege-finder, and the GitHub
# lists: SimplifyJobs, vanshb03, CO0Oper, and SpeedyApply, need no key.)
# USAJOBS: free key from developer.usajobs.gov (Request API Key).
# USAJOBS_EMAIL must be the same email you signed up with (they check it).
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Adzuna: free key from developer.adzuna.com (Register). You get an app id AND an app key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# JSearch: on rapidapi.com, open JSearch -> Pricing -> subscribe to the free Basic plan
# (stop if it asks for a card). Then copy the X-RapidAPI-Key from the Endpoints tab.
# Free plan is about 200 requests a month. If this is empty, the importer skips JSearch.
JSEARCH_API_KEY=
# Or, with a key from OpenWeb Ninja's own site (app.openwebninja.com -> JSearch -> subscribe to the
# free plan -> API key), put it here instead. Only one of the two is needed.
OPENWEBNINJA_API_KEY=


# --- AI tags for job posts (backend/src/ai-tags.ts). Optional: without a key, it's skipped ---
# After each import, a free AI model tags each new job with the majors it fits and the skills it
# names, for Best fit. Only public job posts are sent to it, never anything about a student.
# Google Gemini (free): aistudio.google.com -> Get API key -> Create API key. Leave the other two
# empty to use Gemini 3.5 Flash-Lite.
AI_API_KEY=
# Or Groq (also free): console.groq.com -> API Keys, then
#   AI_BASE_URL=https://api.groq.com/openai/v1   and   AI_MODEL=llama-3.1-8b-instant
AI_BASE_URL=
AI_MODEL=
# how many new jobs to tag per run. Empty = 100 (about 10 requests, well inside the free limits)
AI_JOBS_PER_RUN=
